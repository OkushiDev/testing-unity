# Auto-detectar archivos de texto y normalizarlos a LF en el repositorio
* text=auto eol=lf

# Archivos de Unity basados en YAML/Texto
*.asset text eol=lf
*.mat text eol=lf
*.prefab text eol=lf
*.unity text eol=lf
*.meta text eol=lf
*.inputactions text eol=lf
*.uss text eol=lf
*.uxml text eol=lf

# Código fuente y configuraciones
*.cs text diff=csharp eol=lf
*.json text eol=lf
*.txt text eol=lf
*.wlt text eol=lf